# Copy to .env.local and fill in real values there. Never commit secrets.
# Process environment wins over these files. .env.local overrides .env.

# Local cross-source files. The demo must not use this engine.
LEDGERWISE_DATA_DIR=data/generated
# zetaris for the demo, local only for tests. There is no silent fallback.
LEDGERWISE_GATEWAY=zetaris

# Postgres that holds the two ledgerwise_* databases (data/load_postgres.py)
# LEDGERWISE_PG_HOST=127.0.0.1
# LEDGERWISE_PG_PORT=5432
# Host name the Zetaris container uses to reach that Postgres
# LEDGERWISE_PG_URL_HOST=host.docker.internal

# Zetaris direct REST. Names match the public getting-started client.
# Create the API key in the Zetaris UI (Management -> API Tokens).
# Copy the numeric organisation ID from Management -> Organisation.
# ZETARIS_REST_URL must end in /api/v1.0. Do not guess a host.
ZETARIS_REST_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=

# Optional UI-proxy route from the same docs. Not used by the gateway yet.
ZETARIS_BASE_URL=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# JDBC is the other documented route. It needs their driver JAR. Unused until REST is blocked.
ZETARIS_JDBC_URL=
ZETARIS_JDBC_JAR=

# Which provider writes the summary: nvidia (Nemotron, default) or meterless.
# LLM_PROVIDER=nvidia

# NVIDIA Nemotron. Key from https://build.nvidia.com/settings/api-keys (starts nvapi-).
# Base URL documented by third-party guides: https://integrate.api.nvidia.com/v1
# Leave NEMOTRON_MODEL blank, run `python -m backend.llm.probe nvidia`, copy a listed id.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NEMOTRON_MODEL=

# Meterless. Do not invent this URL. Nightshift's documented example is a local
# OpenAI-compatible base such as http://127.0.0.1:8088/v1. Set it only if that
# service is actually running.
METERLESS_BASE_URL=
METERLESS_API_KEY=
# Nightshift routing mode (documented: meterless/auto, meterless/fast, ...). Read GET /v1/models.
# METERLESS_MODEL=meterless/auto
